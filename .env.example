# Pick one LLM provider. All of them speak the OpenAI chat-completions format.
LLM_PROVIDER=auto            # auto | subq | sarvam | ollama | custom

SUBQ_API_KEY=
SUBQ_MODEL=subq-1m-preview

SARVAM_API_KEY=
SARVAM_MODEL=glm5.3

OLLAMA_MODEL=gemma4:e2b

# Only for LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# FalkorDB (defaults to local Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Optional: otherwise the `gh` CLI token is used
GITHUB_TOKEN=
